@baseUrl = {{url}}/api/v1/auth

@email = {{email}}
@password = {{password}}
@firstName = {{$random.name.firstName}}
@lastName = {{$random.name.lastName}}

### Вход
POST {{baseUrl}}/login HTTP/1.1
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}"
}

### Регистрация нового пользователя
POST {{baseUrl}}/register HTTP/1.1
Content-Type: application/json

{
  "email": "{{email}}",
  "password": "{{password}}",
  "firstName": "{{firstName}}",
  "lastName": "{{lastName}}"
}

### Информация о пользователе
GET {{baseUrl}}/me HTTP/1.1

### Выход
# @no-redirect
POST {{baseUrl}}/logout HTTP/1.1