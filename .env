# Application
PROJECT_NAME=bitshop

# Database
DATABASE_USERNAME=username
DATABASE_PASSWORD=password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bitshop
DATABASE_URL="jdbc:postgresql://${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Session
SESSION_NAMESPACE=spring:session
SESSION_NAME=JSESSIONID
SESSION_SECURE=false
SESSION_HTTP_ONLY=false
SESSION_MAX_AGE=360000

# S3 (Minio)
S3_USERNAME=denis
S3_PASSWORD=denis012345
S3_URL=http://localhost:9000
S3_BUCKET=bitshop
S3_REGION=us-east-1
